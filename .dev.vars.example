# Copy this file to .dev.vars for local testing with `npx wrangler pages dev public`.
# .dev.vars is in .gitignore — keep real keys out of GitHub.
# On the live site, set the same names in Cloudflare → your Pages project → Settings → Variables and Secrets.

# Stripe secret key (use the sk_test_… key while testing)
STRIPE_SECRET_KEY=sk_test_replace_me

# Resend API key and the sender address (must be on a domain you verified in Resend)
RESEND_API_KEY=re_replace_me
MAIL_FROM="Your Company <noreply@yourdomain.com>"

# Where form messages are delivered
CONTACT_TO=info@yourdomain.com
SUPPORT_TO=support@yourdomain.com

# Optional: Cloudflare Turnstile secret key (spam protection)
# TURNSTILE_SECRET_KEY=
